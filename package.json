{
  "name": "merchant-outreach-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic outreach pipeline with deterministic gates, human approval and idempotent sending.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && encore build docker merchant-outreach-agent:local --skip-config",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev": "encore run",
    "generate:merchants": "node scripts/generate-merchants.ts",
    "seed": "node scripts/generate-merchants.ts && node scripts/seed-merchants.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "encore.dev": "^1.57.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.0"
  }
}