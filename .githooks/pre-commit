#!/bin/sh
#
# Runs the full verification suite before allowing a commit.
#
# This exists because a commit once went out with a broken build after
# typecheck, lint and tests had passed and been reported as "validation
# passed". The build was never run. CI caught it; this catches it earlier.
#
# To skip it — see the note at the bottom of this file before you do:
#
#     git commit --no-verify

set -e

echo "pre-commit: running npm run verify"
echo

# No Docker check here: `verify` stops at typecheck and needs nothing running.
# The container build is `npm run build:docker`, and CI is where it has to pass.

if ! npm run verify; then
	echo >&2
	echo "pre-commit: verify failed — commit blocked." >&2
	echo "            Fix it, or use 'git commit --no-verify' if you are committing" >&2
	echo "            work in progress on a branch. Run 'npm run verify' before you push." >&2
	exit 1
fi

echo
echo "pre-commit: verify passed"

# On --no-verify: a blocked commit in the middle of unfinished work is worse
# than a broken commit on a branch. Saving work in progress has to stay
# possible. The gate that must not be bypassed is CI, which runs the same
# checks on the pushed branch and cannot be skipped from a developer's machine.
