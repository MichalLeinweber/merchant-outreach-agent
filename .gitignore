# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Encore generated code and local state (these lines are maintained by the CLI)
/encore.gen
/.encore
encore.gen.go
encore.gen.cue

# Environment — secrets never belong in the repository
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/
*.lcov

# Browser-automation scratch output: screenshots, console logs and page
# snapshots written while checking the dashboard by hand.
.playwright-mcp/

# Python (evals harness)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Eval run output. The reports are regenerated by every run; the datasets, the
# baseline and the recorded fixtures are committed on purpose, because they are
# what the suite replays and compares against.
evals/reports/

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
