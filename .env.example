# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
#   cp .env.example .env.local
#
# Nothing here is required to run the demo. The defaults below run the whole
# pipeline from recorded fixtures, with no API key and no network.

# ─── LLM client ────────────────────────────────────────────────

# live     real API calls, real tokens, real cost
# record   real API calls, and every response is written to fixtures/llm/
# fixture  replay from fixtures/llm/, no network, deterministic  (default)
LLM_MODE=fixture

# Required only for LLM_MODE=live and LLM_MODE=record.
# Never commit a real key. Never paste one into a chat or an issue.
ANTHROPIC_API_KEY=

# Where recorded responses live. Override only if you keep a second set.
# LLM_FIXTURE_DIR=./fixtures/llm

# ─── Campaign controls ─────────────────────────────────────────

# Triage results below this confidence are escalated from Haiku to Sonnet.
# Escalation rate is a dashboard metric: it shows what uncertainty costs.
TRIAGE_ESCALATION_THRESHOLD=0.6

# Hard ceiling on model spend for a single campaign, in US dollars. When it is
# reached the run stops and unprocessed merchants keep their current state.
# There is no silent continuation.
CAMPAIGN_COST_CAP_USD=5.00

# ─── Mock delivery provider ────────────────────────────────────

# Share of send attempts the mock provider fails, 0.0 to 1.0. Used to prove
# that a retry after a failure still cannot produce a second delivery.
PROVIDER_FAILURE_RATE=0.05
